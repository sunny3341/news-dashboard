# Naver API (https://www.ncloud.com/) 에서 발급받은 API 키
NAVER_CLIENT_ID=your_naver_client_id_here
NAVER_CLIENT_SECRET=your_naver_client_secret_here

# Anthropic API 키 (console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Cloud Console(console.cloud.google.com)
SHEET_URL=your_google_sheet_url_here

# NewsAPI (https://newsapi.org) 에서 발급받은 API 키 (해외 뉴스 보조 소스)
NEWSAPI_KEY=your_newsapi_key_here

# 검색할 키워드 (쉼표로 구분)
SEARCH_KEYWORDS=취업,채용,공채,인턴,신입,AI 채용,AI 인재,데이터 분석가 채용,빅데이터 채용,헬스케어 채용,바이오 채용,구조조정,신사업 진출

# 키워드 1개당 가져올 최대 기사 수
MAX_ARTICLES=10

# True면 대시보드가 조회 전용으로 동작 (승인/수정/반려, 일괄 처리 버튼 숨김)
READ_ONLY_MODE=False
